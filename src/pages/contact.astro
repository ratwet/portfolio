---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Kaushal Kumar for engineering internships, research roles, collaborations, and technical discussions."
>
  <header class="page-header wrap">
    <p class="hero-eyebrow">Get in touch</p>
    <h1 class="hero-headline">Let's talk about useful work.</h1>
    <p class="hero-sub max-w-56ch">
      I am actively interested in internships, engineering teams, research opportunities, and technical collaborations where building real hardware or software systems is part of the work.
    </p>
  </header>

  <section class="wrap">
    <div class="contact-grid">
      <!-- Email Card with Copy button -->
      <div class="contact-card">
        <div>
          <h2 class="contact-card-name">Email</h2>
          <p class="contact-card-desc">
            Direct inbox. A short description of the problem, role, or project is plenty.
          </p>
        </div>
        <div class="contact-card-actions">
          <a class="btn btn-primary" href="mailto:kaushalkumar@duck.com">
            Send Email ↗
          </a>
          <button
            class="contact-card-copy"
            id="copy-email-btn"
            type="button"
            data-email="kaushalkumar@duck.com"
          >
            📋 Copy address
          </button>
        </div>
        <span class="contact-card-detail">kaushalkumar@duck.com</span>
      </div>

      <!-- GitHub Card -->
      <a
        class="contact-card"
        href="https://github.com/ratwet"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div>
          <h2 class="contact-card-name">GitHub</h2>
          <p class="contact-card-desc">
            Source code, robotics firmware, CV experiments, and public project repositories.
          </p>
        </div>
        <span class="contact-card-detail">github.com/ratwet ↗</span>
      </a>

      <!-- LinkedIn Card -->
      <a
        class="contact-card"
        href="https://www.linkedin.com/in/kaushal-kumar-072739206"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div>
          <h2 class="contact-card-name">LinkedIn</h2>
          <p class="contact-card-desc">
            Professional background, academic coursework updates, and network connections.
          </p>
        </div>
        <span class="contact-card-detail">linkedin.com/in/kaushal-kumar-072739206 ↗</span>
      </a>
    </div>
  </section>

  <section class="wrap">
    <span class="label">Current Status</span>
    <h2 class="section-heading section-heading-offset">Open to selected opportunities</h2>
    <p class="muted-copy max-w-56ch">
      Priority domains: applied AI and machine learning, real-time computer vision, embedded systems and edge IoT, robotics competitions, and low-level Linux systems programming.
    </p>
  </section>
</BaseLayout>

<script>
  function initContactCopy() {
    const copyBtn = document.getElementById('copy-email-btn');
    const toast = document.getElementById('toast');
    let timer: number | undefined;

    if (!copyBtn || copyBtn.dataset.bound === 'true') return;
    copyBtn.dataset.bound = 'true';

    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'kaushalkumar@duck.com';
      try {
        await navigator.clipboard.writeText(email);
        if (toast) {
          toast.textContent = `✓ Copied to clipboard (${email})`;
          toast.classList.add('visible');
          if (timer) clearTimeout(timer);
          timer = window.setTimeout(() => {
            toast.classList.remove('visible');
          }, 2400);
        }
      } catch (err) {
        // Fallback
        window.location.href = `mailto:${email}`;
      }
    });
  }

  initContactCopy();
  document.addEventListener('astro:page-load', initContactCopy);
</script>
