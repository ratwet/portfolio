---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const certifications=(await getCollection('certifications')).sort((a,b)=>a.data.date<b.data.date?1:-1);
const focusAreas=['Computer Vision','Machine Learning','Embedded Systems','Robotics','Python / C++','Technical Mentorship'];
const seminars=[{title:'AI Builders Weekend',org:"Masters' Union",location:'New Delhi',description:'Workshop on building AI agents from scratch in Python, including autonomous agent architecture, tool calling, and ReAct mechanics.'},{title:'National Seminar on AI for Good Governance',org:'Dr. Ambedkar International Centre',location:'New Delhi',description:'National deliberations on the India AI Mission, Project Tapestry, distributed AI, DSS Studio, sovereignty, ethics, and governance.'}];
---
<BaseLayout title="About" description="Kaushal Kumar is a Mathematics & Computing student building practical AI, computer vision, edge systems, and robotics.">
<section class="wrap"><p class="hero-eyebrow">About</p><h1 class="hero-headline" style="max-width:22ch;">Curious about systems, serious about learning.</h1><p class="hero-sub">I am Kaushal Kumar, a Mathematics &amp; Computing student building practical AI, computer vision, edge systems, robotics, and technical workflows. I learn by shipping, measuring, and explaining what I build.</p></section>
<section class="wrap"><h2 class="section-heading">Current direction</h2><div class="tag-row">{focusAreas.map(tag=><span class="tag">{tag}</span>)}</div></section>
<section class="wrap"><h2 class="section-heading">Education</h2><div class="entry"><div class="entry-meta">2025–2029<br/>In progress</div><div><h3 class="entry-title">Central University of Jammu</h3><p class="entry-org">B.Tech · Mathematics &amp; Computing</p><p style="color:var(--color-ink-dim);">Linear Algebra · Discrete Mathematics · Data Structures &amp; Algorithms · Computer Organization · Probability &amp; Stochastic Processes</p></div></div><div class="entry"><div class="entry-meta">Completed<br/>80%</div><div><h3 class="entry-title">School of Excellence Madanpur Khadar</h3><p class="entry-org">Senior Secondary · Science Stream (PCM)</p></div></div></section>
<section class="wrap"><h2 class="section-heading">Credentials</h2>{certifications.map(cert=><div class="entry"><div class="entry-meta">{cert.data.issuer}<br/>{cert.data.dateLabel}</div><div><h3 class="entry-title">{cert.data.name}</h3>{cert.data.credentialId&&<p class="entry-org" style="font-family:var(--font-mono);font-size:var(--step--1);">{cert.data.credentialId}</p>}{cert.data.verifyUrl&&<a class="btn btn-secondary" href={cert.data.verifyUrl} target="_blank" rel="noopener noreferrer">Verify credential ↗</a>}</div></div>)}</section>
<section class="wrap"><h2 class="section-heading">Seminars &amp; workshops</h2>{seminars.map(s=><div class="entry"><div class="entry-meta">{s.location}</div><div><h3 class="entry-title">{s.title}</h3><p class="entry-org">{s.org}</p><p style="color:var(--color-ink-dim);">{s.description}</p></div></div>)}</section>
</BaseLayout>
