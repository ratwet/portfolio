---
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  { path: '/og.png', category: 'Computer Vision', title: 'Finger Gesture Cursor Control', note: 'Real-time hand tracking mapped to cursor control.' },
  { path: '/og.png', category: 'Robotics', title: 'Robo Soccer', note: 'Wireless 4-wheel differential-drive robot with browser control.' },
  { path: '/og.png', category: 'Edge and IoT', title: 'ESP32 IoT Device Simulator', note: 'MQTT telemetry, simulated sensors, and an edge-device workflow.' },
  { path: '/og.png', category: 'Robotics', title: 'RoboTraverse', note: 'Rope-traversing robot built for a robotics club time trial.' },
];
---

<BaseLayout title="Media" description="Project images, hardware work, workshops, and event photography from Kaushal Kumar's technical journey.">
  <section class="wrap">
    <p class="hero-eyebrow">Media</p>
    <h1 class="hero-headline" style="max-width:20ch;">See the work in context.</h1>
    <p class="hero-sub">A visual archive of robotics, computer vision, embedded systems, and project work.</p>
  </section>

  <section class="wrap">
    <div class="media-grid">
      {items.map((item) => (
        <figure class="media-card">
          <div class="media-card-image">
            <img src={item.path} alt={item.title} loading="lazy" />
          </div>
          <figcaption class="media-card-body">
            <div class="media-card-kind">{item.category}</div>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
