import BaseLayout from '../layouts/BaseLayout.astro';
const items=[{kind:'Video',path:'/assets/media/finger-gesture.mp4',category:'Computer Vision',title:'Finger Gesture Cursor Tracking',note:'Reserved for the project demo once the original recording is added.'},{kind:'Video',path:'/assets/media/robo-soccer.mp4',category:'Robotics',title:'Robo Soccer Match Highlights',note:'Reserved for field footage and the browser-based control demonstration.'},{kind:'Video',path:'/assets/media/esp32-mqtt.mp4',category:'Edge and IoT',title:'ESP32 MQTT Telemetry',note:'Reserved for a walkthrough of the simulated device and telemetry flow.'},{kind:'Video',path:'/assets/media/robotraverse.mp4',category:'Robotics',title:'RoboTraverse — Race Run',note:'Reserved for footage of the record run once available.'},{kind:'Photo',path:'/assets/media/ai-governance-seminar.jpg',category:'Event · New Delhi',title:'National Seminar on AI for Good Governance',note:'Add the original event photograph when it is ready for publication.'},{kind:'Photo',path:'/assets/media/ai-builders-weekend.jpg',category:'Workshop · New Delhi',title:'AI Builders Weekend',note:'Add the original workshop photograph when it is ready for publication.'},{kind:'Photo',path:'/assets/media/esp32-testing.jpg',category:'Hardware · CUJ',title:'ESP32 and Sensor Testing',note:'Add the original hardware photograph when it is ready for publication.'}];
---
<BaseLayout title="Media" description="Project demos, hardware work, workshops, and event photography from Kaushal Kumar's technical journey."><section class="wrap"><p class="hero-eyebrow">Media</p><h1 class="hero-headline" style="max-width:20ch;">See the work in context.</h1><p class="hero-sub">Hardware, field tests, workshops, and project demonstrations belong here. The page is prepared for original assets and intentionally ships without fabricated media.</p></section><section class="wrap"><div class="media-grid">{items.map(item=><div class="media-card"><div class="media-card-placeholder">{item.kind}<br/>Asset path<br/><span class="media-card-path">{item.path}</span></div><div class="media-card-body"><div class="media-card-kind">{item.category}</div><h3>{item.title}</h3><p>{item.note}</p></div></div>)}</div></section></BaseLayout>
