---
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  { path: '/media/robotraverse.jpg', category: 'Robotics', title: 'RoboTraverse', note: 'Rope-traversing robot built for the CSE Robotics Club time trial.' },
  { path: '/media/robot.png', category: 'Robotics', title: 'Robo Soccer Robot', note: 'Four-wheel differential-drive robot with browser-based wireless control.' },
  { path: '/media/wokwi_simulation.png', category: 'Edge & IoT', title: 'ESP32 IoT Device Simulator', note: 'Wokwi simulation of sensor telemetry and MQTT publishing.' },
  { path: '/media/assetsimage.png', category: 'Computer Vision', title: 'Finger Gesture Cursor Control', note: 'Real-time hand tracking and gesture-based cursor control.' }
];
---

<BaseLayout title="Media" description="Project photographs and technical visuals from Kaushal Kumar's robotics, computer vision, and embedded systems work.">
  <section class="wrap">
    <p class="hero-eyebrow">Media</p>
    <h1 class="hero-headline" style="max-width:20ch;">The work, in pictures.</h1>
    <p class="hero-sub">A visual record of projects, prototypes, simulations, and technical builds.</p>
  </section>

  <section class="wrap">
    <div class="media-grid">
      {items.map((item) => (
        <figure class="media-card">
          <div class="media-card-image">
            <img src={item.path} alt={`${item.title}: ${item.note}`} loading="lazy" />
          </div>
          <figcaption class="media-card-body">
            <div class="media-card-kind">{item.category}</div>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
