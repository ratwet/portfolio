---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowField from '../components/FlowField.astro';
const allProjects = await getCollection('projects');
const featured = allProjects.filter((p) => p.data.featured).sort((a,b)=>a.data.sortOrder-b.data.sortOrder).slice(0,4);
---
<BaseLayout title="Home" fullTitle="Kaushal Kumar - Applied AI, Computer Vision & Robotics" description="Portfolio of Kaushal Kumar, a Mathematics & Computing student building applied AI, computer vision, edge systems, and robotics.">
  <section class="hero"><FlowField /><div class="wrap hero-content"><p class="hero-eyebrow">Mathematics & Computing · Applied AI, CV, Robotics</p><h1 class="hero-headline">I build technical systems that hold up when you look closely.</h1><p class="hero-sub">B.Tech Mathematics &amp; Computing student focused on applied AI, computer vision, embedded systems, and robotics - measured, documented, and built to be inspected, not just demoed.</p><div class="hero-actions"><a class="btn btn-primary" href="/projects/">See selected work</a><a class="btn btn-secondary" href="/contact/">Get in touch</a></div></div></section>
  <section class="wrap"><div class="meta-row"><div class="meta-col"><span class="label">Focus</span><p>Computer Vision · Machine Learning · Embedded Systems · Robotics</p></div><div class="meta-col"><span class="label">Education</span><p>B.Tech Mathematics &amp; Computing, Central University of Jammu - 2025–2029</p></div><div class="meta-col"><span class="label">Currently</span><p>Mentoring student teams at CUJ · e-Yantra, and building robotics for competition</p></div></div></section>
  <section class="wrap"><h2 class="section-heading">Selected work</h2><div class="work-list">{featured.map((project)=><a class="work-item" href={`/projects/${project.id}/`}><div class="work-item-main"><span class="label">{project.data.category}</span><h3 class="work-item-title">{project.data.title}</h3><p class="work-item-summary">{project.data.summary}</p></div><div class="work-item-meta">{project.data.metrics?.[0]?.value}</div></a>)}</div><p style="margin-top:var(--space-8);"><a class="btn btn-secondary" href="/projects/">View full project archive</a></p></section>
  <section class="wrap"><h2 class="section-heading">How I work</h2><div class="process-list"><div class="process-step"><span class="label">01 Frame</span><h3>Define the problem</h3><p>Scope the inputs, constraints, and a real success metric before writing code.</p></div><div class="process-step"><span class="label">02 Build</span><h3>Make it measurable</h3><p>Build the smallest version of the system that can actually be tested.</p></div><div class="process-step"><span class="label">03 Improve</span><h3>Profile and document</h3><p>Find the real bottleneck, fix it, and write down what changed and why.</p></div></div></section>
  <section class="wrap"><h2 class="section-heading">Have something worth building?</h2><p class="prose-wrap" style="color:var(--color-ink-dim);margin-bottom:var(--space-8);">Internships, research opportunities, and collaborations where building something is part of the conversation.</p><a class="btn btn-primary" href="/contact/">Start a conversation</a></section>
</BaseLayout>
