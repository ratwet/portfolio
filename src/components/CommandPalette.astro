---
const pages = [
  { num: '01', label: 'About', href: '/about/' },
  { num: '02', label: 'Work', href: '/projects/' },
  { num: '03', label: 'Experience', href: '/experience/' },
  { num: '04', label: 'Media', href: '/media/' },
  { num: '05', label: 'Contact', href: '/contact/' },
];
---
<div class="palette-backdrop" data-open="false" id="palette-backdrop">
  <div class="palette" role="dialog" aria-modal="true" aria-label="Jump to">
    <div class="palette-header"><span>Jump to</span><input class="palette-input" id="palette-input" type="text" placeholder="Type a page name..." autocomplete="off" /><span>ESC</span></div>
    <ul class="palette-list" id="palette-list">
      {pages.map((p) => <li><a class="palette-item" href={p.href} data-label={p.label.toLowerCase()} data-num={p.num}><span><span class="palette-item-num">{p.num}</span>{p.label}</span><span aria-hidden="true">↗</span></a></li>)}
    </ul>
  </div>
</div>
<script>
  const backdrop = () => document.getElementById('palette-backdrop');
  const input = () => document.getElementById('palette-input') as HTMLInputElement | null;
  const open = () => { backdrop()?.setAttribute('data-open','true'); const i=input(); if(i){i.value=''; i.focus();} };
  const close = () => { backdrop()?.setAttribute('data-open','false'); };
  const filter = (q:string) => document.querySelectorAll<HTMLElement>('#palette-list .palette-item').forEach(a => { const li=a.closest('li'); if(li) li.style.display=(a.dataset.label??'').includes(q.trim().toLowerCase())?'':'none'; });
  function bind(){
    const b=backdrop(), i=input(), t=document.getElementById('palette-trigger');
    if(t&&t.dataset.bound!=='true'){t.dataset.bound='true';t.addEventListener('click',open)}
    if(b&&b.dataset.bound!=='true'){b.dataset.bound='true';b.addEventListener('click',e=>{if(e.target===b)close()})}
    if(i&&i.dataset.bound!=='true'){i.dataset.bound='true';i.addEventListener('input',()=>filter(i.value));i.addEventListener('keydown',e=>{if(e.key==='Enter'){const a=[...document.querySelectorAll<HTMLAnchorElement>('#palette-list .palette-item')].find(x=>(x.closest('li') as HTMLElement)?.style.display!=='none');if(a){e.preventDefault();close();a.click()}}})}
  }
  if(!(window as any).__paletteKeysBound){(window as any).__paletteKeysBound=true;document.addEventListener('keydown',e=>{const target=e.target as HTMLElement|null;const typing=target?.tagName==='INPUT'||target?.tagName==='TEXTAREA'||target?.isContentEditable;if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();backdrop()?.getAttribute('data-open')==='true'?close():open()}else if(e.key==='Escape'&&backdrop()?.getAttribute('data-open')==='true')close();else if(e.key==='/'&&!typing&&backdrop()?.getAttribute('data-open')!=='true'){e.preventDefault();open()}})}
  bind(); document.addEventListener('astro:page-load',bind);
</script>
