---
const pages = [
  { num: '01', label: 'About', href: '/about/' },
  { num: '02', label: 'Work', href: '/projects/' },
  { num: '03', label: 'Experience', href: '/experience/' },
  { num: '04', label: 'Media', href: '/media/' },
  { num: '05', label: 'Contact', href: '/contact/' },
];
---
<div class="palette-backdrop" data-open="false" id="palette-backdrop">
  <div class="palette" role="dialog" aria-modal="true" aria-labelledby="palette-title">
    <div class="palette-header"><span id="palette-title">Jump to</span><input class="palette-input" id="palette-input" type="text" placeholder="Type a page name..." autocomplete="off" aria-controls="palette-list" /><span>ESC</span></div>
    <ul class="palette-list" id="palette-list">
      {pages.map((p) => <li><a class="palette-item" href={p.href} data-label={p.label.toLowerCase()} data-num={p.num}><span><span class="palette-item-num">{p.num}</span>{p.label}</span><span aria-hidden="true">↗</span></a></li>)}
    </ul>
  </div>
</div>
<script>
  let paletteCleanup: (() => void) | null = null;

  function initPalette() {
    paletteCleanup?.();
    paletteCleanup = null;

    const backdrop = document.getElementById('palette-backdrop');
    const inputEl = document.getElementById('palette-input') as HTMLInputElement | null;
    const trigger = document.getElementById('palette-trigger');
    const paletteEl = backdrop?.querySelector('.palette');
    let previousFocus: HTMLElement | null = null;
    let activeIndex = 0;

    if (!backdrop || !inputEl) return;

    const getItems = () =>
      [...document.querySelectorAll<HTMLAnchorElement>('#palette-list .palette-item')]
        .filter((a) => !(a.closest('li') as HTMLLIElement | null)?.hidden);

    const close = () => {
      backdrop.setAttribute('data-open', 'false');
      previousFocus?.focus();
      previousFocus = null;
    };

    const setActive = (index: number) => {
      const visible = getItems();
      if (!visible.length) return;
      activeIndex = (index + visible.length) % visible.length;
      visible.forEach((item, i) => item.setAttribute('aria-current', i === activeIndex ? 'true' : 'false'));
      visible[activeIndex]?.focus();
    };

    const open = () => {
      previousFocus = document.activeElement as HTMLElement | null;
      backdrop.setAttribute('data-open', 'true');
      inputEl.value = '';
      filter('');
      inputEl.focus();
      activeIndex = 0;
    };

    const filter = (q: string) => {
      document.querySelectorAll<HTMLElement>('#palette-list li').forEach((li) => {
        const a = li.querySelector<HTMLAnchorElement>('.palette-item');
        li.hidden = !(a?.dataset.label ?? '').includes(q.trim().toLowerCase());
      });
      activeIndex = 0;
    };

    // Trigger button
    const onTriggerClick = () => open();
    if (trigger) trigger.addEventListener('click', onTriggerClick);

    // Backdrop click to close
    const onBackdropClick = (e: Event) => { if (e.target === backdrop) close(); };
    backdrop.addEventListener('click', onBackdropClick);

    // Palette keyboard navigation
    const onPaletteKeydown = (event: Event) => {
      const e = event as KeyboardEvent;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const visible = getItems();
        const focused = document.activeElement as HTMLAnchorElement | null;
        const current = focused ? visible.indexOf(focused) : -1;
        setActive(e.key === 'ArrowDown' ? current + 1 : current - 1);
        return;
      }
      if (e.key === 'Tab') {
        const focusable = [inputEl, ...getItems()].filter(Boolean) as HTMLElement[];
        if (!focusable.length) return;
        const first = focusable[0], last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    };
    if (paletteEl) paletteEl.addEventListener('keydown', onPaletteKeydown);

    // Input filtering and navigation
    const onInput = () => filter(inputEl.value);
    inputEl.addEventListener('input', onInput);

    const onInputKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Enter') { const a = getItems()[activeIndex]; if (a) { e.preventDefault(); close(); a.click(); } }
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(0); }
      if (e.key === 'ArrowUp') { e.preventDefault(); setActive(getItems().length - 1); }
    };
    inputEl.addEventListener('keydown', onInputKeydown);

    // Global keyboard shortcut (Ctrl/Cmd + K and /)
    const onGlobalKeydown = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement | null;
      const typing = target?.tagName === 'INPUT' || target?.tagName === 'TEXTAREA' || target?.isContentEditable;
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        backdrop.getAttribute('data-open') === 'true' ? close() : open();
      } else if (e.key === 'Escape' && backdrop.getAttribute('data-open') === 'true') {
        close();
      } else if (e.key === '/' && !typing && backdrop.getAttribute('data-open') !== 'true') {
        e.preventDefault();
        open();
      }
    };
    document.addEventListener('keydown', onGlobalKeydown);

    paletteCleanup = () => {
      if (trigger) trigger.removeEventListener('click', onTriggerClick);
      backdrop.removeEventListener('click', onBackdropClick);
      if (paletteEl) paletteEl.removeEventListener('keydown', onPaletteKeydown);
      inputEl.removeEventListener('input', onInput);
      inputEl.removeEventListener('keydown', onInputKeydown);
      document.removeEventListener('keydown', onGlobalKeydown);
    };
  }

  initPalette();
  document.addEventListener('astro:page-load', initPalette);
  document.addEventListener('astro:before-swap', () => paletteCleanup?.());
</script>
